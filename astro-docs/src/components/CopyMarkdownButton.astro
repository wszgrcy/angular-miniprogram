---
interface Props {
  /** 当前页面 markdown 源文的地址 */
  src: string;
}

const { src } = Astro.props;
const t = Astro.locals.t;
const labels = {
  idle: t('docCopy.idle'),
  done: t('docCopy.done'),
  failed: t('docCopy.failed'),
};
---

<button
  type="button"
  class="doc-copy"
  data-doc-copy
  data-pagefind-ignore
  data-src={src}
  data-labels={JSON.stringify(labels)}
>
  <svg
    class="icon icon-copy"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    width="16"
    height="16"
  >
    <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
    <path
      d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
    ></path>
  </svg>
  <svg
    class="icon icon-check"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    width="16"
    height="16"
  >
    <path d="M20 6 9 17l-5-5"></path>
  </svg>
  <span data-label aria-live="polite">{labels.idle}</span>
</button>

<style>
  .doc-copy {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    background: var(--sl-color-gray-7);
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font);
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    cursor: pointer;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }

  .doc-copy:hover:not(:disabled) {
    color: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
  }

  .doc-copy:disabled {
    cursor: default;
    opacity: 0.7;
  }

  .doc-copy:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .icon-check {
    display: none;
  }

  .doc-copy.is-done {
    color: var(--sl-color-green-high);
    border-color: var(--sl-color-green-high);
  }

  .doc-copy.is-failed {
    color: var(--sl-color-red-high);
    border-color: var(--sl-color-red-high);
  }

  .doc-copy.is-done .icon-check {
    display: block;
  }

  .doc-copy.is-done .icon-copy {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .doc-copy.is-done {
      color: var(--sl-color-green);
      border-color: var(--sl-color-green);
    }

    .doc-copy.is-failed {
      color: var(--sl-color-red);
      border-color: var(--sl-color-red);
    }
  }

  html[data-theme='dark'] .doc-copy.is-done {
    color: var(--sl-color-green);
    border-color: var(--sl-color-green);
  }

  html[data-theme='dark'] .doc-copy.is-failed {
    color: var(--sl-color-red);
    border-color: var(--sl-color-red);
  }
</style>

<script>
  type State = 'idle' | 'done' | 'failed';

  async function writeToClipboard(text: string) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.appendChild(area);
    area.select();
    document.execCommand('copy');
    area.remove();
  }

  function setState(btn: HTMLButtonElement, state: State) {
    const labels = JSON.parse(btn.dataset.labels ?? '{}') as Record<string, string>;
    btn.classList.toggle('is-done', state === 'done');
    btn.classList.toggle('is-failed', state === 'failed');
    const label = btn.querySelector('[data-label]');
    if (label) label.textContent = labels[state] ?? '';
  }

  async function copyMarkdown(btn: HTMLButtonElement) {
    btn.disabled = true;
    try {
      const res = await fetch(btn.dataset.src!);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      await writeToClipboard(await res.text());
      setState(btn, 'done');
    } catch {
      setState(btn, 'failed');
    }
    setTimeout(() => {
      setState(btn, 'idle');
      btn.disabled = false;
    }, 1600);
  }

  // 事件委托：页面上所有按钮共用一个监听，省掉逐个绑定
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const btn = event.target.closest('button[data-doc-copy]');
    if (!(btn instanceof HTMLButtonElement) || btn.disabled) return;
    void copyMarkdown(btn);
  });
</script>
