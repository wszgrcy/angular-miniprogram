{
  "extends": "./tsconfig.base.json",
  "files": ["./src/library/platform/index.ts"],

  "compilerOptions": {
    "noImplicitThis": true,
    "outDir": "dist",
    "declaration": true,
    "target": "ES2015",
    "module": "esnext",
    "strict": true,
    "useUnknownInCatchVariables": false,
    "stripInternal": true,
    "lib": ["es2019", "dom"],
    "typeRoots": ["./src/library"],
    "types": ["declaration"],
    "paths": {
      "angular-miniprogram/platform/default": [
        "./src/library/platform/default/index.ts"
      ],
      "angular-miniprogram/platform/wx": ["./src/library/platform/wx/index.ts"],
      "angular-miniprogram/platform/type": [
        "./src/library/platform/type/index.ts"
      ],
      "angular-miniprogram/platform": ["./src/library/platform/index.ts"]
    }
  },
  "exclude": [
    "./src/**/*.template.ts",
    "./src/**/*.d.ts",
    "**/*.spec.ts",
    "test"
  ],
  "angularCompilerOptions": {
    "enableIvy": true,
    "compilationMode": "full"
  }
}
