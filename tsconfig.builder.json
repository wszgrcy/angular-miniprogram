{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@angular/build/private": [
        "./node_modules/@angular/build/src/private.d.ts"
      ],
      // vite 的 package.json 没有 main / types 字段，只靠 exports map，
      // moduleResolution: node10 认不出来，这里显式指到类型入口
      "vite": ["./node_modules/vite/dist/node/index.d.ts"],
      // 同上：这两个子路径也只靠 exports map 暴露。
      // vitest/browser 是设备端 runner 入口（startTests / collectTests），
      // vite/module-runner 提供 EvaluatedModules。
      "vitest/browser": ["./node_modules/vitest/dist/browser.d.ts"],
      "vite/module-runner": [
        "./node_modules/vite/dist/node/module-runner.d.ts"
      ],
      // abortcontroller-polyfill 完全没有类型（也无 @types 包），
      // 用本地最小声明撑住。见该文件顶部说明。
      "abortcontroller-polyfill/dist/abortcontroller": [
        "./src/builder/platform/template/abortcontroller-ponyfill.d.ts"
      ],
      // static-injector 7 只靠 exports map 暴露类型（types: ./import/index.d.ts），
      // moduleResolution: node10 认不出来（与 vite / @angular/* 同因）。
      // 不映射的话 strict 下会报 TS7016 隐式 any，inject() 也丢类型。
      "static-injector": ["./node_modules/static-injector/import/index.d.ts"]
    },
    "noImplicitThis": true,
    // 原先进程是 script/build.ts（为了挂 static-injector transformer），它会先把
    // 所有诊断跑完再决定要不要 emit。改成直接 tsc 后，这两项必须显式声明，
    // 否则类型报错仍会把脏 JS 写进 dist/。
    "noEmitOnError": true,
    // TS 6.0 CLI 会报 TS5011（程序化 API 不报），必须显式声明 rootDir。
    "rootDir": "./src/builder",
    "outDir": "./dist/builder",
    "declaration": false,
    "strict": true
  },
  "include": ["src/builder"],
  "exclude": [
    "./**/fixture",
    "./**/*.template.ts",
    "./**/*.d.ts",
    "**/*.spec.ts",
    "**/*.xspec.ts",
    "**/*/karma/plugin/**/*",
    "**/*/karma/client/**/*"
  ]
}
