{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@angular/build/private": [
        "./node_modules/@angular/build/src/private.d.ts"
      ],
      // vite 的 package.json 没有 main / types 字段，只靠 exports map，
      // moduleResolution: node10 认不出来，这里显式指到类型入口
      "vite": ["./node_modules/vite/dist/node/index.d.ts"]
    },
    "noImplicitThis": true,
    "outDir": "./dist/builder",
    "declaration": false,
    "strict": true
  },
  "include": ["src/builder"],
  "exclude": [
    "./**/fixture",
    "./**/*.template.ts",
    "./**/*.d.ts",
    "**/*.spec.ts",
    "**/*.xspec.ts",
    "**/*/karma/plugin/**/*",
    "**/*/karma/client/**/*"
  ]
}
