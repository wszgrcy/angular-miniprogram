{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@angular/build/private": [
        "./node_modules/@angular/build/src/private.d.ts"
      ]
    },
    "noImplicitThis": true,
    "outDir": "./dist/builder",
    "declaration": false,
    "strict": true
  },
  "include": ["src/builder"],
  "exclude": [
    "./**/fixture",
    "./**/*.template.ts",
    "./**/*.d.ts",
    "**/*.spec.ts",
    "**/*.xspec.ts",
    "**/*/karma/plugin/**/*",
    "**/*/karma/client/**/*"
  ]
}
