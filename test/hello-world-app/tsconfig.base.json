{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // TypeScript 6.0 把 strict（含 noImplicitAny / strictPropertyInitialization 等）
    // 变成了默认开启。fixture 之前依赖的是这些默认关闭、只显式开 strictNullChecks 的行为，
    // 这里显式写回 strict: false，保留原有严格度（单独设置的 strictNullChecks 不受影响）。
    "strict": false,
    "strictNullChecks": true,
    // TS 6.0 废弃了 baseUrl，但 paths 还要靠它做相对基准
    "ignoreDeprecations": "6.0",
    "target": "es2022",
    "module": "es2020",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2018", "dom"],
    "paths": {
      "angular-miniprogram": ["../../dist"],
      "angular-miniprogram/platform": ["../../dist/platform"],
      "angular-miniprogram/platform/type": ["../../dist/platform/type"],
      "angular-miniprogram/platform/wx": ["../../dist/platform/wx"],
      "angular-miniprogram/platform/default": ["../../dist/platform/default"],
      "angular-miniprogram/platform/zjtd": ["../../dist/platform/zjtd"],
      "angular-miniprogram/forms": ["../../dist/forms"],
      "angular-miniprogram/common": ["../../dist/common"],
      "angular-miniprogram/common/http": ["../../dist/common/http"],
      "angular-miniprogram/karma/client": ["../../src/builder/karma/client"],
      "angular-miniprogram/event-dispatch-contract": ["../../src/builder/karma/client/event-dispatch-contract"]
    }
  },
  "angularCompilerOptions": {
    // 与 tsconfig.library.json 同理：小程序自定义元素不在 Angular 的 DOM schema 里，
    // Angular 21 默认开启的 host binding 校验会对它们全部报 NG8002。
    "typeCheckHostBindings": false
  }
}
