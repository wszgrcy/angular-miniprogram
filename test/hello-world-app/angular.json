{
  "$schema": "",
  "version": 1,
  "newProjectRoot": "./projects",
  "cli": {},
  "schematics": {},
  "targets": {},
  "projects": {
    "app": {
      "root": "src",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "targets": {
        "build": {
          "builder": "angular-miniprogram:application",
          "options": {
            "pages": [
              {
                "glob": "**/*.entry.ts",
                "input": "./src/pages",
                "output": "pages"
              }
            ],
            "platform": "wx",
            "outputPath": "dist/app",
            "index": "",
            "main": "src/main.ts",
            "polyfills": "",
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              {
                "glob": "project.config.json",
                "input": "./src",
                "output": "./"
              },
              {
                "glob": "app.json",
                "input": "./src",
                "output": "./"
              }
            ],
            "styles": ["src/styles.css"],
            "scripts": []
          }
        },
        "test": {
          "builder": "angular-miniprogram:vitest",
          "options": {
            "main": "./src/test.ts",
            "outputPath": "dist/vitest/app",
            "platform": "wx",
            "port": 17900,
            "clientHost": "127.0.0.1",
            "pages": [
              {
                "glob": "**/*.entry.ts",
                "input": "./src/spec",
                "output": "pages"
              }
            ],
            "assets": [
              {
                "glob": "project.config.json",
                "input": "./src",
                "output": "./"
              },
              {
                "glob": "app.json",
                "input": "./src",
                "output": "./"
              }
            ],
            "styles": ["src/styles.css"],
            "tsConfig": "src/tsconfig.spec.json"
          }
        }
      }
    },
    "test-library": {
      "projectType": "library",
      "root": "projects/test-library",
      "sourceRoot": "projects/test-library/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "angular-miniprogram:library",
          "options": {
            "project": "projects/test-library/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/test-library/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/test-library/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
