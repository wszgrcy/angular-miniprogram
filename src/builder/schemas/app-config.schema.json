{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "小程序 app 配置（app.json）",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ]
          }
        ]
      },
      "description": "主包页面路径（不含扩展名）；pages[0] 是默认启动页"
    },
    "entryPagePath": {
      "type": "string",
      "description": "启动页；不填用 pages[0]，可以是主包页也可以是分包页"
    },
    "window": {
      "type": "object",
      "properties": {},
      "required": [],
      "description": "全局窗口表现"
    },
    "tabBar": {
      "type": "object",
      "properties": {
        "custom": {
          "type": "boolean",
          "description": "自定义 tabBar（微信系）"
        },
        "customize": {
          "type": "boolean",
          "description": "自定义 tabBar（支付宝）"
        },
        "list": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pagePath": {
                "type": "string"
              }
            },
            "required": [
              "pagePath"
            ]
          },
          "description": "tab 列表，pagePath 必须是主包页面"
        }
      },
      "required": [],
      "description": "底部 tab 配置"
    },
    "subpackages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "分包根目录，相对产物根；不得以 / 开头、不得包含 .."
          },
          "pages": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path"
                  ]
                }
              ]
            },
            "description": "分包内页面路径，相对 root"
          },
          "independent": {
            "type": "boolean",
            "description": "独立分包：不依赖主包即可运行"
          }
        },
        "required": [
          "root"
        ]
      },
      "description": "分包列表（微信写法）"
    },
    "subPackages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "分包根目录，相对产物根；不得以 / 开头、不得包含 .."
          },
          "pages": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path"
                  ]
                }
              ]
            },
            "description": "分包内页面路径，相对 root"
          },
          "independent": {
            "type": "boolean",
            "description": "独立分包：不依赖主包即可运行"
          }
        },
        "required": [
          "root"
        ]
      },
      "description": "分包列表（支付宝 / 百度写法）"
    },
    "preloadRule": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string"
          },
          "packages": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "properties": {},
                "required": []
              }
            ]
          }
        },
        "required": []
      },
      "description": "分包预下载规则，key 是页面路径，packages 是分包 root"
    },
    "lazyCodeLoading": {
      "type": "string",
      "description": "按需注入：requiredComponents / requiredPages"
    },
    "_platform": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "description": "按平台分段补字段，key 用平台名（wx / zfb / …）"
    }
  },
  "required": []
}
