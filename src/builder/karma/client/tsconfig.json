{
  "compilerOptions": {
    "outDir": "../../../../dist/karma/client",
    "strict": false,
    "strictNullChecks": false,
    "allowUnreachableCode": true,
    "noUnusedParameters": false,
    "sourceMap": true,
    "declaration": true,
    "target": "ES2021",
    "module": "CommonJS",
    "lib": ["ES2021"],
    // TS 6.0 不再像以前那样自动把 node_modules/@types 全量塞进来，
    // 这里显式声明需要的全局类型（jasmine 的命名空间、node 的 Console 等）。
    "typeRoots": ["../../../../node_modules/@types"],
    "types": ["jasmine", "node"],
    "skipLibCheck": true
  },
  "files": ["index.ts"]
}
