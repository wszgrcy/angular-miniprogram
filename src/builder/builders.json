{
  "$schema": "../../node_modules/@angular-devkit/architect/src/builders-schema.json",
  "builders": {
    "application": {
      "implementation": "./vite",
      "schema": "./vite/schema.json",
      "description": "小程序构建builder（Vite 版，替代 webpack）"
    },
    "library": {
      "implementation": "./library/builder",
      "schema": "./library/schema.json",
      "description": "小程序构建library"
    },
    "vitest": {
      "implementation": "./vitest/vite",
      "schema": "./vitest/vite/schema.json",
      "description": "小程序测试构建（把 spec 编进产物，由 vitest 通过 WebSocket 驱动）"
    }
  }
}
