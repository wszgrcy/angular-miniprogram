{
  "name": "angular-miniprogram",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:library": "vitest run --project library",
    "test:builder": "vitest run --project builder",
    "test:ci": "npm run build:library && npm test",
    "test:watch": "vitest",
    "test:wechat": "node ./script/wechat-vitest.cjs --project ./test/hello-world-app --dist ./test/hello-world-app/dist/vitest/app",
    "coverage": "vitest run --coverage",
    "prebuild": "rimraf ./dist",
    "build": "npm run build:library && npm run build:builder && npm run copy:assets && npm run build:schema && node ./script/link-self.cjs",
    "build:schema": "tsx ./script/build-cli-schema.ts",
    "gen:schema": "tsx ./script/gen-builder-schema.ts",
    "gen:config-schema": "tsx ./script/gen-config-schema.ts",
    "check:schema": "tsx ./script/gen-builder-schema.ts --check && tsx ./script/gen-config-schema.ts --check",
    "copy:assets": "cpx \"./src/builder/**/*.json\" ./dist/builder && cpx \"./src/builder/**/*.d.ts\" ./dist/builder && cpx \"./src/builder/**/*.js\" ./dist/builder && cpx ./readme.md ./dist",
    "build:library": "tsx ./script/ensure-sync.ts && tsx ./script/build-ng-package.ts",
    "build:builder": "npm run typecheck:builder && tsx ./script/vite-build.ts",
    "typecheck": "npm run typecheck:builder && npm run typecheck:spec && npm run typecheck:config && npm run typecheck:script",
    "typecheck:builder": "tsc -p ./tsconfig.builder.json --noEmit",
    "typecheck:spec": "tsc -p ./tsconfig.spec.json --noEmit",
    "prepare": "husky install",
    "lint": "eslint --max-warnings 0 \"./**/*.ts\"",
    "sync": "code-recycle ./script/package-sync.ts --cwd ./src/library",
    "docs:dev": "npm --prefix ./astro-docs run dev",
    "docs:build": "npm --prefix ./astro-docs run build",
    "typedoc": "typedoc",
    "deploy": "npm run typedoc && npm run build:library && npm test && npm run coverage-badge -- init && cpx \"./deploy/doc/**/*\" ./docs && cpx \"./deploy/api-doc/**/*\" ./docs/api-doc && npm run coverage && npm run coverage-badge -- success && cpx ./deploy/doc/assets/img/badge.svg ./docs/assets/img",
    "coverage-badge": "tsx ./script/coverage-badge.ts",
    "typecheck:config": "tsc -p ./tsconfig.config.json --noEmit",
    "typecheck:script": "tsc -p ./tsconfig.script.json --noEmit"
  },
  "private": true,
  "author": "wszgrcy",
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular-devkit/architect": "0.2201.8",
    "@angular-devkit/build-angular": "22.1.8",
    "@angular-devkit/core": "22.1.8",
    "@angular-devkit/schematics": "22.1.8",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@angular/core": "22.1.7",
    "@code-recycle/cli": "^1.3.10",
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/glob": "^7.2.0",
    "@types/node": "^22.19.0",
    "@types/socket.io-client": "^3.0.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitest/coverage-v8": "^4.1.11",
    "birpc": "^4.2.0",
    "cpx": "^1.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-plugin-import-x": "^4.17.1",
    "flatted": "^3.4.4",
    "fs-extra": "11.2.0",
    "glob": "^7.2.0",
    "globals": "^17.13.0",
    "husky": "^7.0.0",
    "mini-types": "^0.1.7",
    "miniprogram-api-typings": "^5.2.3",
    "ng-packagr": "22.1.1",
    "prettier": "3.2.5",
    "pretty-quick": "4.0.0",
    "rimraf": "5.0.5",
    "rxjs": "7.8.2",
    "static-injector": "7.0.0",
    "tslib": "2.8.1",
    "tsx": "^4.7.1",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "weapp.socket.io": "^3.0.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/localize": "22.1.7",
    "abortcontroller-polyfill": "^1.7.8",
    "clsx": "^2.1.1",
    "cyia-code-util": "^1.8.0",
    "es-toolkit": "^1.52.0",
    "valibot": "^1.5.0"
  }
}
