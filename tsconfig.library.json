{
  "extends": "./tsconfig.base.json",
  // "files": ["./src/library/index.ts"],
  "include": ["./src/library"],
  "compilerOptions": {
    "baseUrl": "./src/library",
    "noImplicitThis": true,
    "outDir": "dist",
    "declaration": true,
    "target": "ES2015",
    "module": "esnext",
    "strict": true,
    "useUnknownInCatchVariables": false,
    "lib": ["es2022", "dom", "dom.iterable"],
    "typeRoots": ["./src/library", "./node_modules"],
    "types": ["declaration", "miniprogram-api-typings"],
    "paths": {
      "angular-miniprogram/platform/default": ["./platform/default/index.ts"],
      "angular-miniprogram/platform/wx": ["./platform/wx/index.ts"],
      "angular-miniprogram/platform/type": ["./platform/type/index.ts"],
      "angular-miniprogram/platform": ["./platform/index.ts"],
      "angular-miniprogram/common": ["./common/index.ts"],
      "angular-miniprogram/common/http": ["./common/http/index.ts"]
    }
  },
  "exclude": [
    "./src/**/*.template.ts",
    "./src/**/*.d.ts",
    "**/*.spec.ts",
    "test"
  ],
  "angularCompilerOptions": {
    "enableIvy": true,
    "compilationMode": "full",
    // Angular 21 开始会对 @HostBinding 做 schema 校验（typeCheckHostBindings 默认 true）。
    // 本库的表单 accessor 绑的是小程序自定义元素（checkbox / switch / radio / slider /
    // picker / picker-view），这些永远不在 Angular 的 DOM schema 里，会全部报 NG8002。
    // 这些绑定最终由本库的模板编译器翻译成 wxml，不会真的去 set DOM property，
    // 所以这里关掉 host binding 的类型检查。
    "typeCheckHostBindings": false
  }
}
